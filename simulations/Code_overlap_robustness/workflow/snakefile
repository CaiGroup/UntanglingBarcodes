codes_to_simulate.reset_index(inplace=True)
rule aggregate_codes:
    input: expand("results/sumstats_wtruth/sum_stats_wtruth_npseudocolors_{npcl}.csv", npcl=np.unique(codes_to_simulate.n_pseudocolors))
    output: "results/sum_stats_wtruth.csv"
    script: "scripts/aggregate_sum_stats.py"
