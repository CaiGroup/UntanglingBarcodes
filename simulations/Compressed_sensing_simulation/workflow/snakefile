    output: "results/cand_cpaths/cand_cpaths_{code}_rep_{rep}_nbarcodes{nbarcodes}_nnonspec{nnonspec}_pdrop{pdrop}.csv"
    params: sr = config["search_radius"]
    wildcard_constraints: rep = "\d+", code = "|".join(codes_to_simulate["code"])
    script: "scripts/get_cand_cpaths.jl"

